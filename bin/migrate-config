#!/usr/bin/env python3
"""migrate-config: dry-run by default, --write applies the migration.

Reads whichever of the user (~/.claude/shfmt-permissions.json) and project
(${CLAUDE_PROJECT_DIR}/.claude/shfmt-permissions.json) source files exist,
translates each through lib/config_migration.py (pure, no I/O), and prints a
JSON report per scope: the migrated config, the warnings (dropped knobs,
renames, structural reshapes), the existing command-policy.json target (if
any), and a diff against it.

Without --write this NEVER creates, modifies, or deletes any file - it only
prints the report. With --write, each scope whose source file existed has
its migrated config written to that scope's command-policy.json, silently
overwriting whatever was there. Confirming with the human before passing
--write is the migrate-config SKILL's job, not this script's - see
skills/migrate-config/SKILL.md.

The old shfmt-permissions.json file(s) are never modified or deleted by this
script, in either mode.
"""

import argparse
import difflib
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))

from config_migration import migrate_shfmt_permissions_config  # noqa: E402

SCOPES = ("user", "project")


def _source_path(scope):
    if scope == "user":
        return Path(os.environ.get("HOME", "")) / ".claude" / "shfmt-permissions.json"
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR", os.getcwd())
    return Path(project_dir) / ".claude" / "shfmt-permissions.json"


def _target_path(scope):
    if scope == "user":
        return Path(os.environ.get("HOME", "")) / ".claude" / "command-policy.json"
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR", os.getcwd())
    return Path(project_dir) / ".claude" / "command-policy.json"


def _warning_dict(warning):
    return {"kind": warning.kind, "message": warning.message, "key": getattr(warning, "key", None)}


def _diff_against(existing, new_config):
    if existing == new_config:
        return None
    before = json.dumps(existing, indent=2, sort_keys=True).splitlines()
    after = json.dumps(new_config, indent=2, sort_keys=True).splitlines()
    return "\n".join(difflib.unified_diff(before, after, lineterm="", fromfile="existing", tofile="migrated"))


def _report_for(scope, source, target):
    if not source.exists():
        return {"sourceExists": False}

    old_cfg = json.loads(source.read_text())
    result = migrate_shfmt_permissions_config(old_cfg, source=scope)

    report = {
        "sourceExists": True,
        "newConfig": result.new_config,
        "warnings": [_warning_dict(w) for w in result.warnings],
    }
    if target.exists():
        existing = json.loads(target.read_text())
        report["existingTarget"] = existing
        report["diff"] = _diff_against(existing, result.new_config)
    else:
        report["existingTarget"] = None
        report["diff"] = None
    return report


def main(argv):
    parser = argparse.ArgumentParser(
        prog="migrate-config",
        description=(
            "Translate shfmt-permissions.json into command-policy.json. Dry-run by default "
            "(prints the report, writes nothing); --write applies it."
        ),
    )
    parser.add_argument(
        "--write", action="store_true", help="Write the migrated config to each scope's command-policy.json."
    )
    args = parser.parse_args(argv)

    report = {}
    for scope in SCOPES:
        source = _source_path(scope)
        target = _target_path(scope)
        report[scope] = _report_for(scope, source, target)

        if args.write and report[scope]["sourceExists"]:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(json.dumps(report[scope]["newConfig"], indent=2) + "\n")

    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
