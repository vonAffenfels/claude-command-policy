#!/usr/bin/env python3
"""User-facing command-policy explain entrypoint.

Replaces shfmt-permissions' render-shfmt-permissions. Prints the merged
config's rendering (auto-allowed commands first, per the deny-by-default
model) plus any warnings, then exits 0.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))

from config_loader import load_config_from_environment


def main():
    config = load_config_from_environment()
    print(config.explain())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
