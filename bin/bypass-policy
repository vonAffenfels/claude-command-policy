#!/usr/bin/env python3
"""bypass-policy: the escape hatch's runtime half.

Does nothing but exec what it was passed. Its entire value is that
Config.decision_for (lib/escalation_policy.py) recognizes a line that is one
invocation of it and returns `passthrough` WITHOUT analysing anything - the
wrapped command is never inspected, so no objection (blocked command,
sensitive path, unknowable operand, substitution) turns it into a dead-ending
`deny`. See escalation_policy.py's module docstring for the recognition rule
(a line merely sharing a list/pipeline with the wrapper is not recognised).

Run by the session itself when no auto-allowed command does the job - it is a
statement to the plugin ("I know no entry allows this"), not a request for the
operator to run something. Argv form only: the words are exec'd exactly as the
shell split them; a single string naming a whole command is not a program.

Usage:
  bypass-policy <program> [args...]
  bypass-policy ls -d bin
  bypass-policy bash -c 'cat file.txt && python3 script.py'
"""

import os
import sys


def main(argv):
    if not argv:
        return 0
    try:
        os.execvp(argv[0], argv)
    except OSError as error:
        print(f"bypass-policy: {argv[0]}: {error}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
