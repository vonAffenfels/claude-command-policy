#!/usr/bin/env python3
"""add-allow-policy: the durable-fix escalation's runtime half.

Config.decision_for (lib/escalation_policy.py) recognizes this program name
as the sole invocation on its line and always forces `ask`, carrying a JSON
diff of exactly the entry this script would append plus the stated
--intent - approving that dialog IS the write. This script performs it; see
lib/add_allow_write.py for the write-side logic (parsing, validation,
applying the entry).

Usage:
  add-allow-policy <entry> --scope user|project --intent "why"
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))

from add_allow_write import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
